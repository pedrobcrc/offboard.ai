      "id": "ab04ba6a-fac2-4b04-91f8-0a99d8a3499b",
      "name": "Get due outcomes",
      "credentials": {
        "httpHeaderAuth": {
          "id": "IrQO0tjmOmnw7TxJ",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.rows || [];\nconst groups = {};\nfor (const r of rows) {\n  if (!groups[r.offboarding_id]) groups[r.offboarding_id] = [];\n  groups[r.offboarding_id].push(r);\n}\nreturn Object.entries(groups).map(([offboarding_id, tasks]) => ({\n  json: { offboarding_id, task_count: tasks.length, tasks }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "54331f40-1041-42b9-98fc-fd0efe6ee7ec",
      "name": "Group by handover"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cfg = $('Config').first().json;\nconst esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst list = $json.tasks.map(t => {\n  const link = `${cfg.FORM_URL}?proposal_id=${encodeURIComponent(t.proposal_id)}&Task=${encodeURIComponent(t.task_title)}`;\n  return `<li>${esc(t.task_title)} (${t.action}d on ${t.created_at.slice(0,10)}): <a href=\"${link}\">Give feedback</a></li>`;\n}).join('');\nreturn {\n  json: {\n    ...$json,\n    to: cfg.MANAGER_EMAIL,\n    subject: `Handover check: ${$json.task_count} task allocations to review`,\n    html: `<p>Hi,</p><p>These tasks were handed over to a new owner. For each one, please tell us whether the allocation worked (one short form per task):</p><ul>${list}</ul><p>Thanks,<br>Offboard.AI</p>`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "id": "ad97c9f8-49ba-44e0-a40b-89e80db87b86",
      "name": "Build email"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
